# Postgres (development/test)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

# Object storage. Leave S3_BUCKET unset to use local disk (tmp/storage).
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://minio.local:9000
# S3_FORCE_PATH_STYLE=1

# Public URL the iPad uses for dev-storage uploads when S3 is not configured.
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=*
